  },
  "levels": {
    "0": "Not required — not relevant for this role",
    "1": "Aware — understands the concept, no hands-on experience",
    "2": "Practitioner — has applied it in at least one real project",
    "3": "Expert — leads, defines, and advances the field"
  },
  "requirement_tiers": {
    "must_have": "★ Stop-factor: a candidate below level 2 is a disqualifying gap regardless of overall profile strength. In the interview data, these separated hire from no-hire.",
    "ideal_profile": "◆ Marks an ideal candidate. Absence does not disqualify — the candidate stays in the process — but presence makes the case stronger. In the interview data, these separated Strong Yes from Yes.",
    "level_only": "Expected depth without special status."
  },
  "calibration_statuses": {
    "interview_calibrated": "Levels checked against real interview feedback, including hires or offers.",
    "partially_calibrated": "Derived from interview feedback, but no hire in this exact profile yet.",
    "rejections_only": "Based only on rejected candidates — shows what is insufficient, not what is sufficient.",
    "jd_only": "Based on the job description only — not yet checked against interviews.",
    "jd_and_hm_input": "Based on the job description plus the hiring manager's description of the role — not yet checked against interviews."
  },
  "calibration_note": "Role calibration uses specialization-interview feedback. In the source company most candidates are rejected earlier, at the coding round, or later, at system design. Those two stages are captured as interview gates, not as role competencies.",
  "interview_gates": {
    "applies_to": "all roles",
    "required_level": 2,
    "gates": [
      "algorithmic_coding",
      "system_design"
    ],
    "note": "Gates cannot be assessed from a CV. Screening tools should look for indirect signals (e.g. end-to-end system ownership) and raise questions, not reject."
  },
